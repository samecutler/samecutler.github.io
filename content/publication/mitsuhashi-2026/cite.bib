     abstract = "{We report the discovery of two z {\ensuremath{\sim}} 12 galaxy
        candidates with unusually red UV slopes
        ({\ensuremath{\beta}}$_{UV}$ {\ensuremath{\gtrsim}}
        {\ensuremath{-}}1.5), and probe the origin of such colors at
        cosmic dawn. From Prospector fits to the UNCOVER/MegaScience
        dataset{\textemdash}deep JWST/NIRCam imaging of A2744 in 20
        broad- and medium bands{\textemdash}we identify several new z >
        10 galaxies. Medium-band data improve redshift estimates,
        revealing two lensed ({\ensuremath{\mu}} {\ensuremath{\sim}}
        3.3) z {\ensuremath{\sim}} 12 galaxies in a close pair with
        {\ensuremath{\beta}}$_{UV}$ {\ensuremath{\gtrsim}}
        {\ensuremath{-}}1.5 at an UV absolute magnitude of M$_{UV}$
        {\ensuremath{\sim}} {\ensuremath{-}}19 mag, lying away from
        typical scatter on previously known
        M$_{UV}$─{\ensuremath{\beta}}$_{UV}$ relations. Spectral energy
        distribution fitting with Prospector, Bagpipes, and EAZY support
        their high-z nature, with probability of low-z interlopers of
        p(z < 7) < 10\%. The potential low-z interlopers are z
        {\ensuremath{\sim}} 3 quiescent galaxies (QGs), but unexpected
        to be detected at the given field of view unless z
        {\ensuremath{\sim}} 3 QG stellar mass function has a strong turn
        up at logM*[M{\ensuremath{\odot}}]{\ensuremath{\sim}}9. Unlike
        typical blue high-redshift candidates
        ({\ensuremath{\beta}}$_{UV}$ {\ensuremath{\lesssim}}
        {\ensuremath{-}}2.0), these red slopes require either dust or
        nebular continuum reddening. The dust scenario implies A$_{V}$
        {\ensuremath{\sim}} 0.8 mag, which is larger than theoretical
        predictions, but is consistent with a dust-to-stellar mass ratio
        (logMdust/M*{\ensuremath{\sim}}{\ensuremath{-}}3). The nebular
        scenario demands dense gas
        (lognH[cm{\ensuremath{-}}3]{\ensuremath{\sim}}4.0) around hot
        stars (logTeff[K]{\ensuremath{\sim}}4.9). Spectroscopic follow-
        up is essential to determine their true nature and reveal
        missing galaxies at the cosmic dawn.}",
          doi = {10.3847/1538-4357/ae7102},
