        title = "{UNCOVER/MegaScience: No Evidence of Environmental Quenching in a z {\ensuremath{\sim}} 2.6 Protocluster}",
      journal = {\apjl},
     keywords = {James Webb Space Telescope, Galaxy evolution, Galaxy quenching, Extragalactic astronomy, Protoclusters, Galaxy environments, 2291, 594, 2040, 506, 1297, 2029, Astrophysics of Galaxies},
         year = 2025,
