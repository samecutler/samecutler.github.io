       author = {{Cutler}, Sam E. and {Robbins}, Luke and {Marchesini}, Danilo and {Suess}, Katherine A. and {Muzzin}, Adam and {Brammer}, Gabriel and {Asada}, Yoshihisa and {Martis}, Nicholas S. and {Alberts}, Stacey and {Antwi-Danso}, Jacqueline and {Cloonan}, Aidan P. and {Labb{\'e}}, Ivo and {Miller}, Tim B. and {Mitsuhashi}, Ikki and {Pope}, Alexandra and {Sajina}, Anna and {Sarrouh}, Ghassan T.~E. and {Sharma}, Monu and {Stefanon}, Mauro and {Vidal}, Edgar P. and {Willott}, Chris J. and {Bezanson}, Rachel and {Brada{\v{c}}}, Maru{\v{s}}a and {Cooper}, Olivia R. and {Feldmann}, Robert and {Ben Forrest} and {Glazebrook}, Karl and {Greene}, Jenny E. and {La Torre}, Valentina and {Lin}, Jamie and {Maseda}, Michael V. and {McConachie}, Ian and {Nanayakkara}, Themiya and {Noirot}, Ga{\"e}l and {Pan}, Richard and {Patel}, Kesha A. and {Pratt}, Veronica and {Sawicki}, Marcin and {Setton}, David J. and {Weaver}, John R. and {van der Wel}, Arjen and {Whitaker}, Katherine E. and {Zhang}, Yunchong and {Zaidi}, Kumail},
        title = "{Toward Unbreaking the Universe: MINERVA Measurements of Color Gradients in Massive Quiescent Galaxies Can Help Ease Too-early Star Formation Tensions}",
      journal = {\apjl},
     keywords = {Galaxy evolution, Galaxy formation, Galaxy quenching, High-redshift galaxies, James Webb Space Telescope, 594, 595, 2040, 734, 2291, Astrophysics of Galaxies},
         year = 2026,
        month = sep,
       volume = {1008},
       number = {1},
          eid = {L11},
        pages = {L11},
     abstract = "{The discovery of a population of massive, ancient quiescent galaxies
        within the first 2 Gyr of the Universe's history has led to
        significant tensions with models of galaxy formation. However,
        these analyses are often based on slit spectroscopy, which
        typically captures only the centermost region of these galaxies
        and, crucially, assumes these cores are representative of the
        entire galaxy. To illustrate the varying stellar populations
        present throughout these galaxies, we present an analysis of
        color gradients in four z > 3,
        log(M{\ensuremath{\star}}/M{\ensuremath{\odot}})>11 quiescent
        galaxies which previous works have argued are in tension with
        models. Using medium-band photometry from MINERVA JWST
        observations, we measure resolved photometry in a series of
        elliptical annuli out to 0.″7 (\raisebox{-0.5ex}\textasciitilde4
        R$_{e}$). We find negative color gradients in three galaxies,
        and for the most extreme color gradient ({\ensuremath{\Delta}}(U
        - V)/{\ensuremath{\Delta}}R = -0.126 {\ensuremath{\pm}} 0.030
        mag kpc$^{-1}$), we find the stellar mass is 0.1 dex lower when
        compared to photometry measured within NIRSpec slits. In the
        limiting case where these color gradients are entirely driven by
        age, we find lessened tensions with extreme value statistics
        models out to z \raisebox{-0.5ex}\textasciitilde 9.5, though
        different stellar population modeling choices also contribute
        significantly. Ultimately, these findings highlight the need for
        integral field unit spectroscopy. Spatially resolved spectra can
        provide the evidence needed to break the age--dust--metallicity
        degeneracy, and reliably separate the effects of the observed
        color gradients from the effects of different physical modeling
        assumptions on the formation histories of these galaxies.}",
          doi = {10.3847/2041-8213/ae960c},
archivePrefix = {arXiv},
       eprint = {2606.02698},
 primaryClass = {astro-ph.GA},
       adsurl = {https://ui.adsabs.harvard.edu/abs/2026ApJ..1008L..11C},
