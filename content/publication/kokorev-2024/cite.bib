        pages = {38},
     abstract = "{Observations with the James Webb Space Telescope (JWST) have uncovered
        numerous faint active galactic nuclei (AGN) at z
        {\ensuremath{\sim}} 5 and beyond. These objects are key to our
        understanding of the formation of supermassive black holes
        (SMBHs), their coevolution with host galaxies, as well as the
        role of AGN in cosmic reionization. Using photometric colors and
        size measurements, we perform a search for compact red objects
        in an array of blank deep JWST/NIRCam fields totaling
        {\ensuremath{\sim}}640 arcmin$^{2}$. Our careful selection
        yields 260 reddened AGN candidates at 4 < z $_{phot}$ < 9,
        dominated by a point-source-like central component
        ({\ensuremath{\langle}}r $_{eff}${\ensuremath{\rangle}} < 130
        pc) and displaying a dichotomy in their rest-frame colors (blue
        UV and red optical slopes). Quasar model fitting reveals our
        objects to be moderately dust-extincted (A $_{V}$
        {\ensuremath{\sim}} 1.6), which is reflected in their inferred
        bolometric luminosities of L $_{bol}$ = 10$^{44─47}$ erg
        s$^{{\ensuremath{-}}1}$ and fainter UV magnitudes M $_{UV}$ ≃
        {\ensuremath{-}}17 to {\ensuremath{-}}22. Thanks to the large
        areas explored, we extend the existing dusty AGN luminosity
        functions to both fainter and brighter magnitudes, estimating
        their number densities to be {\texttimes}100 higher than for UV-
        selected quasars of similar magnitudes. At the same time, they
        constitute only a small fraction of all UV-selected galaxies at
        similar redshifts, but this percentage rises to
        {\ensuremath{\sim}}10\% for M $_{UV}$ {\ensuremath{\sim}}
        {\ensuremath{-}} 22 at z {\ensuremath{\sim}} 7. Finally,
        assuming a conservative case of accretion at the Eddington rate,
        we place a lower limit on the SMBH mass function at z
        {\ensuremath{\sim}} 5, finding it to be consistent with both
        theory and previous JWST observations.}",
          doi = {10.3847/1538-4357/ad4265},
archivePrefix = {arXiv},
