        title = "{Taking a Break at Cosmic Noon: Continuum-selected Low-mass Galaxies Require Long Burst Cycles}",
      journal = {\apj},
     keywords = {Galaxy evolution, Star formation, Dwarf galaxies, 594, 1569, 416, Astrophysics of Galaxies},
