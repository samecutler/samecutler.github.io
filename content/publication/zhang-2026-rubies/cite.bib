        title = "{RUBIES Spectroscopically Confirms the High Number Density of Quiescent Galaxies from 2 < z< 5}",
      journal = {\apj},
     keywords = {Extragalactic astronomy, Galaxies, High-redshift galaxies, Quenched galaxies, 506, 573, 734, 2016, Astrophysics of Galaxies},
