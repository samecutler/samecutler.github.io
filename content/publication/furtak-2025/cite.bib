        title = "{Investigating photometric and spectroscopic variability in the multiply imaged little red dot A2744-QSO1}",
      journal = {\aap},
     keywords = {gravitational lensing: strong, galaxies: high-redshift, quasars: emission lines, quasars: supermassive black holes, quasars: individual: A2744-QSO1, Astrophysics of Galaxies},
